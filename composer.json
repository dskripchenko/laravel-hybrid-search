{
    "name": "dskripchenko/laravel-hybrid-search",
    "description": "Search for Laravel on PostgreSQL alone: full-text (tsvector, morphology per language) and vectors (pgvector) fused by Reciprocal Rank Fusion, with access filtering in SQL.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "search", "postgresql", "full-text", "tsvector", "pgvector", "hybrid-search"],
    "authors": [{"name": "Denis Skripchenko", "email": "denskrp90@gmail.com"}],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {"Dskripchenko\\HybridSearch\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Dskripchenko\\HybridSearch\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["Dskripchenko\\HybridSearch\\HybridSearchServiceProvider"],
            "aliases": {"Search": "Dskripchenko\\HybridSearch\\Facades\\Search"}
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"pestphp/pest-plugin": true}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
