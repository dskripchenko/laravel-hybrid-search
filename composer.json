{
    "name": "dskripchenko/laravel-hybrid-search",
    "description": "Search for Laravel on PostgreSQL alone: full-text (tsvector, morphology per language) and vectors (pgvector) fused by Reciprocal Rank Fusion, with access filtering in SQL.",
    "type": "library",
    "keywords": [
        "laravel",
        "search",
        "postgresql",
        "full-text",
        "tsvector",
        "pgvector",
        "vector-search",
        "hybrid-search",
        "rrf",
        "dskripchenko"
    ],
    "homepage": "https://github.com/dskripchenko/laravel-hybrid-search",
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Skripchenko",
            "email": "denskrp90@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/dskripchenko/laravel-hybrid-search/issues",
        "source": "https://github.com/dskripchenko/laravel-hybrid-search",
        "docs": "https://github.com/dskripchenko/laravel-hybrid-search/tree/main/docs"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Dskripchenko\\HybridSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dskripchenko\\HybridSearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dskripchenko\\HybridSearch\\HybridSearchServiceProvider"
            ],
            "aliases": {
                "Search": "Dskripchenko\\HybridSearch\\Facades\\Search"
            }
        },
        "branch-alias": {
            "dev-main": "0.x-dev"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
